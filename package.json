{
  "name": "pulse-player",
  "version": "1.0.0",
  "description": "A fully customisable music player for YouTube, YouTube Music and SoundCloud",
  "main": "main.js",
  "author": "Pulse",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pulse.player",
    "productName": "Pulse",
    "files": ["main.js", "index.html", "styles.css", "renderer.js", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": "dmg", "identity": null },
    "linux": { "target": "AppImage" }
  }
}
